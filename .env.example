# ==============================================================================
# ATELIER NICE — SUPABASE CONFIGURATION
# ==============================================================================
# Obtenha estas credenciais no painel do Supabase (Project Settings -> API):
# https://app.supabase.com/project/_/settings/api

# URL do seu projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Chave anônima pública (anon/public key)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Telefone oficial para atendimento via WhatsApp (apenas dígitos, ex: 12991279309)
VITE_WHATSAPP_PHONE=12991279309
